CPU_REG(CV_ARM64_X15, X15, REG_X, "X15", 0)
CPU_REG(CV_ARM64_X16, X16, REG_X, "X16/IP0", 0)
CPU_REG(CV_ARM64_X17, X17, REG_X, "X17/IP1", 0)
CPU_REG(CV_ARM64_X18, X18, REG_X, "X18", 0)
CPU_REG(CV_ARM64_X19, X19, REG_X, "X19", 0)
CPU_REG(CV_ARM64_X20, X20, REG_X, "X20", 0)
CPU_REG(CV_ARM64_X21, X21, REG_X, "X21", 0)
CPU_REG(CV_ARM64_X22, X22, REG_X, "X22", 0)
CPU_REG(CV_ARM64_X23, X23, REG_X, "X23", 0)
CPU_REG(CV_ARM64_X24, X24, REG_X, "X24", 0)
CPU_REG(CV_ARM64_X25, X25, REG_X, "X25", 0)
CPU_REG(CV_ARM64_X26, X26, REG_X, "X26", 0)
CPU_REG(CV_ARM64_X27, X27, REG_X, "X27", 0)
CPU_REG(CV_ARM64_X28, X28, REG_X, "X28", 0)
CPU_REG(CV_ARM64_FP , Fp , REG_X, "X29/FP", 0) // Frame Pointer
CPU_REG(CV_ARM64_LR , Lr , REG_X, "X30/LR", 0) // Link Register
CPU_REG(CV_ARM64_SP , Sp , REG_X, "SP", 0)     // Stack Pointer
// CPU_REG(CV_ARM64_ZR , Zr , REG_X, "XZR", 0)    // Zero Register

