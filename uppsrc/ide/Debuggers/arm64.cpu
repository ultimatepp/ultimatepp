// ARM64 CPU register definitions for Ultimate++ TheIDE debugger

// -----------------------------
// General-purpose registers (32-bit Wn)
// -----------------------------
CPU_REG(CV_ARM64_W0 , X0 , REG_W, "W0", 0)
CPU_REG(CV_ARM64_W1 , X1 , REG_W, "W1", 0)
CPU_REG(CV_ARM64_W2 , X2 , REG_W, "W2", 0)
CPU_REG(CV_ARM64_W3 , X3 , REG_W, "W3", 0)
CPU_REG(CV_ARM64_W4 , X4 , REG_W, "W4", 0)
CPU_REG(CV_ARM64_W5 , X5 , REG_W, "W5", 0)
CPU_REG(CV_ARM64_W6 , X6 , REG_W, "W6", 0)
CPU_REG(CV_ARM64_W7 , X7 , REG_W, "W7", 0)
CPU_REG(CV_ARM64_W8 , X8 , REG_W, "W8", 0)
CPU_REG(CV_ARM64_W9 , X9 , REG_W, "W9", 0)
CPU_REG(CV_ARM64_W10, X10, REG_W, "W10", 0)
CPU_REG(CV_ARM64_W11, X11, REG_W, "W11", 0)
CPU_REG(CV_ARM64_W12, X12, REG_W, "W12", 0)
CPU_REG(CV_ARM64_W13, X13, REG_W, "W13", 0)
CPU_REG(CV_ARM64_W14, X14, REG_W, "W14", 0)
CPU_REG(CV_ARM64_W15, X15, REG_W, "W15", 0)
CPU_REG(CV_ARM64_W16, X16, REG_W, "W16/IP0", 0)
CPU_REG(CV_ARM64_W17, X17, REG_W, "W17/IP1", 0)
CPU_REG(CV_ARM64_W18, X18, REG_W, "W18", 0)
CPU_REG(CV_ARM64_W19, X19, REG_W, "W19", 0)
CPU_REG(CV_ARM64_W20, X20, REG_W, "W20", 0)
CPU_REG(CV_ARM64_W21, X21, REG_W, "W21", 0)
CPU_REG(CV_ARM64_W22, X22, REG_W, "W22", 0)
CPU_REG(CV_ARM64_W23, X23, REG_W, "W23", 0)
CPU_REG(CV_ARM64_W24, X24, REG_W, "W24", 0)
CPU_REG(CV_ARM64_W25, X25, REG_W, "W25", 0)
CPU_REG(CV_ARM64_W26, X26, REG_W, "W26", 0)
CPU_REG(CV_ARM64_W27, X27, REG_W, "W27", 0)
CPU_REG(CV_ARM64_W28, X28, REG_W, "W28", 0)
CPU_REG(CV_ARM64_W29, Fp , REG_W, "W29/FP", 0) // Frame Pointer
CPU_REG(CV_ARM64_W30, Lr , REG_W, "W30/LR", 0) // Link Register

// -----------------------------
// General-purpose registers (64-bit Xn)
// -----------------------------
CPU_REG(CV_ARM64_X0 , X0 , REG_X, "X0", 0)
CPU_REG(CV_ARM64_X1 , X1 , REG_X, "X1", 0)
CPU_REG(CV_ARM64_X2 , X2 , REG_X, "X2", 0)
CPU_REG(CV_ARM64_X3 , X3 , REG_X, "X3", 0)
CPU_REG(CV_ARM64_X4 , X4 , REG_X, "X4", 0)
CPU_REG(CV_ARM64_X5 , X5 , REG_X, "X5", 0)
CPU_REG(CV_ARM64_X6 , X6 , REG_X, "X6", 0)
CPU_REG(CV_ARM64_X7 , X7 , REG_X, "X7", 0)
CPU_REG(CV_ARM64_X8 , X8 , REG_X, "X8", 0)
CPU_REG(CV_ARM64_X9 , X9 , REG_X, "X9", 0)
CPU_REG(CV_ARM64_X10, X10, REG_X, "X10", 0)
