description "OpenSSL based SSL support for Core\3770,128,128";

library(POSIX) "crypto ssl";

library(WIN32) "usp10 gdi32 crypt32";

library(OSX) "libcrypto.a libssl.a";

library(WIN32 MSC) "libcrypto libssl";

library(WIN32 !MSC) "crypto ssl";

external_dependency(VCPKG) openssl;

external_dependency(DPKG) libssl-dev;

file
	SSL.h,
	Util.cpp,
	InitExit.cpp,
	Socket.cpp,
	P7S.cpp,
	AES.cpp,
	Buffer.hpp,
	Random.cpp,
	SSL.icpp,
	Docs readonly separator,
	src.tpp,
	Copying;

