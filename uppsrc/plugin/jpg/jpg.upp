description "JPEG image file format\3770,128,128";

options(BUILDER_OPTION) NOWARNINGS;

uses
	Draw;

library
	jpeg;

external_dependency(VCPKG) libjpeg-turbo;

external_dependency(DPKG) libjpeg-turbo8-dev;

external_dependency(RPM) libjpeg-turbo-devel;

file
	jpg.h,
	jpgupp.cpp,
	jpgreg.icpp,
	src.tpp,
	lib readonly separator,
	Copying;

