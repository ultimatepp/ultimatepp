description "LZ4 compressor (lower compression but very fast)\3770,128,128";

uses
	Core;

library
	lz4;

external_dependency(VCPKG) lz4;

external_dependency(DPKG) liblz4-dev;

external_dependency(RPM) lz4-devel;

external_dependency(PACMAN) lz4;

file
	lz4.h,
	Compress.cpp,
	Decompress.cpp,
	util.cpp,
	Copying,
	src.tpp;

