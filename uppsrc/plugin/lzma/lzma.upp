description "LZMA compressor (slow, but very good ratio)\3770,128,128";

uses
	Core;

library
	lzma;

external_dependency(VCPKG) liblzma;

external_dependency(DPKG) liblzma-dev;

external_dependency(RPM) xz-devel;

external_dependency(PACMAN) xz;

file
	lzma.h,
	lzma.cpp,
	src.tpp,
	lib readonly separator,
	Copying;

