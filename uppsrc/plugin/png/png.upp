description "PNG image file format U++ encapsulation\3770,128,128";

options(BUILDER_OPTION) NOWARNINGS;

uses
	Core,
	Draw;

library(WIN32 !MSC) png16;

library(WIN32 MSC) libpng16;

pkg_config(POSIX !OSX !STATIC_PNG) libpng;

external_dependency(VCPKG) libpng;

external_dependency(DPKG) libpng-dev;

file
	png.h,
	pngupp.cpp,
	Info readonly separator,
	Copying;

