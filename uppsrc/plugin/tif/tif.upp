description "TIFF image file format\3770,128,128";

options(BUILDER_OPTION) NOWARNINGS;

uses
	plugin\jpg,
	Painter;

library
	"tiff lzma jpeg";

external_dependency(WIN32) tiff;

external_dependency(DPKG) libtiff-dev;

external_dependency(DPKG) liblzma-dev;

external_dependency(DPKG) libjpeg-turbo8-dev;

file
	tif.h,
	tifupp.cpp,
	Copying;

