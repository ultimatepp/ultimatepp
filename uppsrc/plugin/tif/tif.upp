description "TIFF image file format\3770,128,128";

options(BUILDER_OPTION) NOWARNINGS;

uses
	plugin\jpg,
	Painter;

library
	"tiff lzma jpeg";

library(PORTABLE_HYBRID) "jbig Lerc webp sharpyuv";

external_dependency(WIN32) tiff;

external_dependency(DPKG) libtiff-dev;

external_dependency(DPKG) liblzma-dev;

external_dependency(DPKG) libjpeg-turbo8-dev;

external_dependency(RPM) libtiff-devel;

external_dependency(RPM) xz-devel;

external_dependency(RPM) libjpeg-turbo-devel;

file
	tif.h,
	tifupp.cpp,
	Copying;

