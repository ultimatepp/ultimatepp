description "MySQL interface\377";

acceptflags
	NOMYSQL,
	MYSQLDLL;

uses
	Sql;

library(OSX) mysqlclient;

library(WIN32) "crypt32 secur32 shlwapi bcrypt";

library(WIN32 !SHARED) mariadbclient;

library(WIN32 SHARED !MSC) mariadb;

library(WIN32 SHARED MSC) libmariadb;

pkg_config(LINUX | FREEBSD | OPENBSD) "mysqlclient mariadb";

external_dependency(WIN32) libmariadb;

file
	MySql.h,
	MySqlSchema.h,
	MySql.cpp,
	Info readonly separator,
	srcdoc.tpp,
	Copying;

