description "OpenGL widget base class\377";

uses
	CtrlCore;

library(WIN32 (GCC | CLANG)) "glu32 opengl32 glew32";

library(WIN32 MSC SHARED) glew32;

library(WIN32 MSC !SHARED) libglew32;

pkg_config(LINUX | BSD) "gl glu glew";

external_dependency(WIN32) glew;

file
	GLCtrl.h,
	Win32GLCtrl.cpp,
	XGLCtrl.cpp,
	GLCtrl.cpp,
	Meta readonly separator,
	GLCtrl.usc,
	Info readonly separator,
	src.tpp,
	Copying;

